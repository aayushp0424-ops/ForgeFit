# Optional: Get a free USDA FoodData Central API key at https://fdc.nal.usda.gov/api-key-signup
# Without one, DEMO_KEY is used and has strict shared limits.
USDA_API_KEY=DEMO_KEY

# Set your contact URL/email before public usage, as Open Food Facts requests an identifiable User-Agent.
OPEN_FOOD_FACTS_USER_AGENT=ForgeFit/0.3 (contact: your-email@example.com)

# Optional paid AI API: never use NEXT_PUBLIC_ for this or put your key in browser code.
# Leave unset to use ForgeFit's built-in rule-based meal recommender for free.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
